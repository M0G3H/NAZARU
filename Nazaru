check_user_account_inventory() {
    local count
    [[ -r /etc/passwd ]] || { result UNKNOWN '/etc/passwd is not readable'; return; }
    count="$(awk -F: '$3>=1000 && $3!=65534 && $7 !~ /(nologin|false)$/ {n++} END {print n+0}' /etc/passwd 2>/dev/null)"
    result INFO "$count non-system login-capable account(s) with UID >= 1000; validate against approved account inventory"
}

check_authorized_keys() {
    local f mode count=0 risky=0
    for f in /root/authorized_keys /root/.ssh/authorized_keys /home/*/.ssh/authorized_keys; do
        [[ -f "$f" ]] || continue
        count=$((count + 1))
        mode="$(stat -c '%a' "$f" 2>/dev/null)"
        if [[ "$mode" =~ ^[0-7]+$ ]] && (( (8#$mode & 0022) != 0 )); then risky=$((risky + 1)); fi
    done
    if (( risky > 0 )); then result WARN "$count authorized_keys file(s) found; $risky have group/world write bits; key contents were not read or logged";
    else result INFO "$count authorized_keys file(s) found under /root and /home; contents were not read or logged; compare keys with approved inventory"; fi
}

check_systemd_enabled_services() {
    local output count
    if ! have systemctl; then result UNKNOWN 'systemctl unavailable; host may not use systemd'; return; fi
    output="$(systemctl list-unit-files --type=service --state=enabled --no-legend 2>/dev/null)" || { result UNKNOWN 'cannot enumerate enabled systemd services'; return; }
