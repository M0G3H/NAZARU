run_check() {
    local name="$1" fn="$2" cis_id="$3" raw rc status detail
    INDEX=$((INDEX + 1))

    # The function runs in a subshell. A command failure is captured here and
    # cannot terminate the parent script or prevent subsequent tests.
    raw="$("$fn" 2>&1)"
    rc=$?
    if (( rc != 0 )); then
        status='ERROR'
        detail="test function returned non-zero exit code $rc"
    elif [[ "$raw" == *'|'* ]]; then
        status="${raw%%|*}"
        detail="${raw#*|}"
        case "$status" in PASS|WARN|FAIL|INFO|UNKNOWN|ERROR) ;;
            *) status='ERROR'; detail='test returned an invalid status format';;
        esac
    else
        status='ERROR'
        detail='test returned no valid STATUS|DETAIL result'
    fi

    # Keep every result on one line so a single malformed command cannot
    # corrupt the report layout.
    detail="${detail//$'\n'/ }"
    detail="${detail//$'\r'/ }"
    detail="${detail//|/\/}"

    case "$status" in
        PASS) PASS_COUNT=$((PASS_COUNT + 1));;
        WARN) WARN_COUNT=$((WARN_COUNT + 1));;
        FAIL) FAIL_COUNT=$((FAIL_COUNT + 1));;
        INFO) INFO_COUNT=$((INFO_COUNT + 1));;
        UNKNOWN) UNKNOWN_COUNT=$((UNKNOWN_COUNT + 1));;
        ERROR) ERROR_COUNT=$((ERROR_COUNT + 1));;
    esac
    local result_line color
    result_line="[$(printf '%02d' "$INDEX")/$TOTAL_TESTS] [✓] $name | CIS-ID=\"$cis_id\" | STATUS=$status | $detail"

    case "$status" in
        PASS)    color='\033[32m' ;;       # Green
        WARN)    color='\033[31m' ;;       # Red, as requested
        FAIL)    color='\033[1;31m' ;;     # Bold red
        INFO)    color='\033[36m' ;;       # Cyan
        UNKNOWN) color='\033[33m' ;;       # Yellow
        ERROR)   color='\033[35m' ;;       # Magenta
        *)       color='\033[0m' ;;
    esac

    log_result "$result_line" "$color"
}

