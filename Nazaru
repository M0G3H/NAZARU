check_cis_sshd_permit_empty() { cis_sshd_expect_check permitemptypasswords no; }
check_cis_sshd_usepam() { cis_sshd_expect_check usepam yes; }
check_cis_sshd_gssapi() { cis_sshd_expect_check gssapiauthentication no; }
check_cis_sshd_hostbased() { cis_sshd_expect_check hostbasedauthentication no; }
check_cis_sshd_ignore_rhosts() { cis_sshd_expect_check ignorerhosts yes; }
check_cis_sshd_disable_forwarding() { cis_sshd_expect_check disableforwarding yes; }
check_cis_sshd_maxstartups() {
    local v; v="$(sshd_value maxstartups 2>/dev/null)"
    if [[ -z "$v" ]]; then result UNKNOWN 'effective MaxStartups unavailable';
    elif [[ "$v" == 10:30:60 || "$v" =~ ^[0-9]+(:[0-9]+:[0-9]+)?$ ]]; then result INFO "effective MaxStartups=$v; validate against approved benchmark value";
    else result WARN "unrecognized MaxStartups=$v"; fi
}
check_cis_sshd_clientalive() {
    local i c; i="$(sshd_value clientaliveinterval 2>/dev/null)"; c="$(sshd_value clientalivecountmax 2>/dev/null)"
    if [[ "$i" =~ ^[0-9]+$ && "$c" =~ ^[0-9]+$ ]] && (( i > 0 && i <= 300 && c <= 3 )); then result PASS "ClientAliveInterval=$i ClientAliveCountMax=$c";
    else result WARN "ClientAliveInterval=${i:-unset} ClientAliveCountMax=${c:-unset}; review SSH idle-session policy"; fi
}
check_cis_su_restricted() {
    if grep -RhsE '^[[:space:]]*auth[[:space:]].*pam_wheel\.so' /etc/pam.d/su 2>/dev/null | grep -q .; then result PASS 'pam_wheel restriction detected for su';
    else result WARN 'pam_wheel restriction for su not detected'; fi
}
check_cis_cron_yearly() { cis_file_mode_check /etc/cron.yearly 700; }
check_cis_cron_d() { cis_file_mode_check /etc/cron.d 700; }
check_cis_crontab() { cis_file_mode_check /etc/crontab 600; }
check_cis_cron_allow() {
    if [[ -f /etc/cron.allow ]]; then cis_file_mode_check /etc/cron.allow 600;
    elif [[ -f /etc/cron.deny ]]; then result WARN '/etc/cron.allow is absent while /etc/cron.deny exists';
    else result WARN 'neither /etc/cron.allow nor /etc/cron.deny exists'; fi
}



