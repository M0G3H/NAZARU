    printf '\033[0m\n'
}

log_line() {
    printf '%s\n' "$1" >> "$REPORT_FILE" || {
        printf 'ERROR: cannot append to report file: %s\n' "$REPORT_FILE" >&2
        exit 2
    }
    (( QUIET_MODE )) || printf '%s\n' "$1"
}

# Header metadata is always displayed, including in quiet mode.
log_header_line() {
    printf '%s\n' "$1" >> "$REPORT_FILE" || {
        printf 'ERROR: cannot append to report file: %s\n' "$REPORT_FILE" >&2
        exit 2
    }
    printf '%s\n' "$1"
}

log_alert() {
    local message="$1"
    printf '%s\n' "$message" >> "$REPORT_FILE" || exit 2
    printf '\033[1;31m%s\033[0m\n' "$message"
}

log_result() {
    local line="$1" prefix="$2" status_tag="$3" detail="$4" color="$5" status="$6"
    printf '%s\n' "$line" >> "$REPORT_FILE" || {
        printf 'ERROR: cannot append to report file: %s\n' "$REPORT_FILE" >&2
        exit 2
    }
    if (( ! QUIET_MODE )) || [[ "$status" == WARN || "$status" == FAIL || "$status" == ERROR ]]; then
        printf '%s' "$prefix"
        printf '%b%s\033[0m' "$color" "$status_tag"
        if (( DESCRIPTION_MODE )); then
            printf ' [%s]\n' "$detail"
        else
            printf '\n'
        fi
    fi
}
result() {
    local line="$1" color="$2"
    # Keep the report file plain text; apply ANSI color only in the terminal.
    if ! printf '%s
' "$line" >> "$REPORT_FILE"; then
        printf 'ERROR: cannot append to report file: %s
' "$REPORT_FILE" >&2
        exit 2
    fi
    printf '%b%s\033[0m\n' "$color" "$line"
}

result() {
    # Every test returns exactly: STATUS|one-line detail
    printf '%s|%s\n' "$1" "$2"
}

have() { command -v "$1" >/dev/null 2>&1; }

is_active() {
    local unit="$1"
    have systemctl && systemctl is-active --quiet "$unit" 2>/dev/null
}

sshd_value() {
    local key="$1" output value
    if have sshd; then
        output="$(sshd -T 2>/dev/null)"
        value="$(printf '%s\n' "$output" | awk -v k="$(printf '%s' "$key" | tr '[:upper:]' '[:lower:]')" 'tolower($1)==k {print tolower($2); exit}')"
        if [[ -n "$value" ]]; then
            printf '%s' "$value"
            return 0
        fi
    fi
    if [[ -r /etc/ssh/sshd_config ]]; then
        # Fallback only: does not fully resolve Include/Match blocks.
        awk -v k="$(printf '%s' "$key" | tr '[:upper:]' '[:lower:]')" '
            /^[[:space:]]*#/ {next}
            tolower($1)==k {v=tolower($2)}
            END {if (v!="") print v}
        ' /etc/ssh/sshd_config 2>/dev/null
        return 0
    fi
    return 1
}

count_matching_lines() {
    awk 'NF {n++} END {print n+0}'
}

# ---------- Test functions ----------

check_ssh_root_login() {
    local v
    v="$(sshd_value permitrootlogin)" || { result UNKNOWN 'sshd configuration unavailable'; return; }
    if [[ "$v" == no ]]; then result PASS 'effective PermitRootLogin=no'
    elif [[ -z "$v" ]]; then result UNKNOWN 'PermitRootLogin could not be determined'
    else result FAIL "effective PermitRootLogin=$v; set to no if policy requires disabling SSH root login"; fi
}

check_ssh_password_auth() {
    local v
    v="$(sshd_value passwordauthentication)" || { result UNKNOWN 'sshd configuration unavailable'; return; }
    if [[ "$v" == no ]]; then result PASS 'effective PasswordAuthentication=no'
    elif [[ -z "$v" ]]; then result UNKNOWN 'PasswordAuthentication could not be determined'
    else result WARN "effective PasswordAuthentication=$v; prefer key-based or centrally managed MFA-backed access where appropriate"; fi
}

check_root_account() {
    local line state

    if ! have passwd; then
        result UNKNOWN 'passwd command not available'
        return
    fi

    line="$(passwd -S root 2>/dev/null)" || {
        result UNKNOWN 'cannot read root account status; try running with sufficient privileges'
        return
    }

    state="$(printf '%s\n' "$line" | awk '{print $2}')"

    case "$state" in
        L|LK)
            result PASS 'root password is locked'
            ;;
        P)
            result INFO 'root has a password set; this alone does not indicate unauthorized root access'
            ;;
        NP)
            result INFO 'root has no password set; verify account accessibility and recovery policy'
            ;;
        *)
            result UNKNOWN "unrecognized root account status: ${state:-empty}"
            ;;
    esac
}

check_uid0_accounts() {
    local count
    [[ -r /etc/passwd ]] || { result UNKNOWN '/etc/passwd is not readable'; return; }
    count="$(awk -F: '$3==0 {n++} END {print n+0}' /etc/passwd 2>/dev/null)"
    if [[ "$count" -le 1 ]]; then result PASS 'only the standard UID 0 account was found'
    else result FAIL "$count accounts have UID 0; review for unauthorized superuser accounts"; fi
}

check_empty_passwords() {
    local count
    [[ -r /etc/shadow ]] || { result UNKNOWN '/etc/shadow is not readable; run as root to perform this check'; return; }
    count="$(awk -F: '($2==""){n++} END {print n+0}' /etc/shadow 2>/dev/null)"
    if [[ "$count" -eq 0 ]]; then result PASS 'no empty password fields found'
    else result FAIL "$count account(s) have an empty password field; account names and hashes were not recorded"; fi
}

check_sudo_nopasswd() {
    local files=(/etc/sudoers)
    local count=0 f n syntax='not-checked'
    [[ -d /etc/sudoers.d ]] && files+=(/etc/sudoers.d/*)
    for f in "${files[@]}"; do
        [[ -f "$f" && -r "$f" ]] || continue
        n="$(grep -Ehv '^[[:space:]]*#|^[[:space:]]*$' "$f" 2>/dev/null | grep -Eo 'NOPASSWD:' 2>/dev/null | wc -l)"
        count=$((count + n))
    done
    if have visudo && [[ -r /etc/sudoers ]]; then
        if visudo -c >/dev/null 2>&1; then syntax='valid'; else syntax='invalid'; fi
    fi
    if [[ ! -r /etc/sudoers ]]; then result UNKNOWN 'sudoers files are not readable';
    elif [[ "$syntax" == invalid ]]; then result WARN "visudo -c reports a sudoers syntax/configuration problem; NOPASSWD directives found=$count";
    elif [[ "$count" -eq 0 ]]; then result PASS "no active NOPASSWD directives detected; sudoers syntax=$syntax";
    else result WARN "$count active NOPASSWD directive(s) detected; sudoers syntax=$syntax; validate each exception against policy"; fi
}

check_password_max_days() {
    local days
    [[ -r /etc/login.defs ]] || { result UNKNOWN '/etc/login.defs is not readable'; return; }
    days="$(awk '$1=="PASS_MAX_DAYS" && $1 !~ /^#/ {v=$2} END {print v}' /etc/login.defs 2>/dev/null)"
    if [[ ! "$days" =~ ^[0-9]+$ ]]; then result UNKNOWN 'PASS_MAX_DAYS is not configured as an integer';
    elif (( days <= 0 )); then result WARN "PASS_MAX_DAYS=$days; review unlimited/invalid aging policy";
    elif (( days <= 90 )); then result INFO "PASS_MAX_DAYS=$days in login.defs; this mainly affects newly created accounts and does not prove existing accounts comply";
    else result WARN "PASS_MAX_DAYS=$days; value exceeds the script's 90-day review threshold (set threshold according to policy)"; fi
}

check_pam_lockout() {
    local count
    [[ -d /etc/pam.d && -r /etc/pam.d ]] || { result UNKNOWN '/etc/pam.d is unavailable'; return; }
    count="$(grep -RihE '^[[:space:]]*auth[[:space:]].*pam_(faillock|tally2)\.so' /etc/pam.d 2>/dev/null | count_matching_lines)"
    if [[ "$count" -gt 0 ]]; then result PASS "PAM account lockout module reference(s) detected: $count; validate thresholds and PAM stack order";
    else result WARN 'no pam_faillock/pam_tally2 auth rule detected; verify centrally managed authentication separately'; fi
}

check_mfa_config() {
    local pam_count ssh_methods

    pam_count="$(
        grep -RihE '^[[:space:]]*auth[[:space:]].*pam_(google_authenticator|oath|yubico|u2f|duo)' \
            /etc/pam.d 2>/dev/null |
        count_matching_lines
    )"

    ssh_methods="$(sshd_value authenticationmethods 2>/dev/null)"

    if (( pam_count > 0 )) || [[ "$ssh_methods" == *+* ]]; then
        result INFO "possible MFA indicators found (active PAM references=$pam_count, SSH AuthenticationMethods=${ssh_methods:-not-set}); enforcement must be verified manually"
    else
        result UNKNOWN 'no active local MFA indicators detected; centrally managed MFA may still be enabled'
    fi
}

check_ssh_access_restrictions() {
    local allow_users allow_groups listen
    allow_users="$(sshd_value allowusers 2>/dev/null)"
    allow_groups="$(sshd_value allowgroups 2>/dev/null)"
    listen="$(sshd_value listenaddress 2>/dev/null)"
    if [[ -n "$allow_users" || -n "$allow_groups" ]]; then
        result PASS 'effective AllowUsers/AllowGroups restriction detected; validate intended administrators'
    elif [[ -n "$listen" && "$listen" != 0.0.0.0:* && "$listen" != '::'* ]]; then
        result INFO 'SSH appears bound to a specific address; verify network/firewall source restrictions separately'
    else
        result WARN 'no effective AllowUsers/AllowGroups restriction detected; firewall/VPN restrictions are not inferred here'
    fi
}

check_listening_sockets() {
    local output count
    if have ss; then
        output="$(ss -H -lntup 2>/dev/null)" || { result UNKNOWN 'ss failed; run with root for process and complete socket visibility'; return; }
        count="$(printf '%s\n' "$output" | count_matching_lines)"
        result INFO "$count TCP/UDP listening socket(s) detected by ss -lntup; review exposed services against the host role"
    elif have netstat; then
        output="$(netstat -lntup 2>/dev/null)" || { result UNKNOWN 'netstat failed'; return; }
        count="$(printf '%s\n' "$output" | awk 'NR>2 && NF {n++} END {print n+0}')"
        result INFO "$count TCP/UDP listening socket(s) detected; process visibility may require root"
    else
        result UNKNOWN 'neither ss nor netstat is installed; ss is provided by iproute2'
    fi
}

check_telnet_service() {
    local active=0 installed=0
    is_active telnet.socket && active=1
    is_active telnet.service && active=1
    have in.telnetd && installed=1
    if (( active )); then result FAIL 'Telnet socket/service is active; disable and remove if not explicitly required';
    elif (( installed )); then result WARN 'Telnet daemon binary detected but no active unit confirmed';
    else result PASS 'no common Telnet daemon/unit detected'; fi
}

check_ftp_service() {
    local active=0 installed=0 unit
    for unit in vsftpd.service proftpd.service pure-ftpd.service; do is_active "$unit" && active=1; done
    for unit in vsftpd proftpd pure-ftpd ftpd; do have "$unit" && installed=1; done
    if (( active )); then result FAIL 'an FTP server service is active; prefer SFTP/SSH or a specifically approved secure alternative';
    elif (( installed )); then result WARN 'FTP server binary detected but no active unit confirmed';
    else result PASS 'no common FTP server binary/unit detected'; fi
}

check_samba_smb() {
    local active=0 installed=0 minproto
    is_active smbd.service && active=1
    have smbd && installed=1
    if (( !active && !installed )); then result PASS 'Samba server not detected'; return; fi
    if (( !active )); then result INFO 'Samba binary is installed but smbd.service is not active'; return; fi
    if ! have testparm; then result UNKNOWN 'Samba is active but testparm is missing; install samba-common-tools (RHEL/Fedora) or samba-common-bin (Debian/Ubuntu)'; return; fi
    minproto="$(testparm -s --parameter-name='server min protocol' 2>/dev/null | tail -n 1 | tr '[:lower:]' '[:upper:]')"
    case "$minproto" in
        SMB2|SMB2_02|SMB2_10|SMB3|SMB3_00|SMB3_02|SMB3_11) result PASS "Samba active; server min protocol=$minproto" ;;
        NT1|LANMAN1|LANMAN2) result FAIL "Samba active with legacy minimum protocol=$minproto; disable SMB1/NT1" ;;
        *) result UNKNOWN 'Samba active but minimum protocol could not be determined';;
    esac
}

check_snmpv3() {
    local active=0 installed=0 community=0 users=0 f

    is_active snmpd.service && active=1

    if have pgrep && pgrep -x snmpd >/dev/null 2>&1; then
        active=1
    fi

    have snmpd && installed=1

    if (( !active )); then
        if (( installed )); then
            result INFO 'SNMP daemon is installed but no running daemon was detected; configuration was not treated as exposed'
        else
            result PASS 'SNMP daemon not detected as installed/active'
        fi
        return
    fi

    for f in /etc/snmp/snmpd.conf /etc/snmp/snmpd.local.conf; do
        [[ -r "$f" ]] || continue

        grep -Eiq '^[[:space:]]*(rocommunity|rwcommunity|com2sec)[[:space:]]' "$f" && community=1
        grep -Eiq '^[[:space:]]*(rouser|rwuser)[[:space:]]' "$f" && users=1
    done

    if (( community )); then
        result WARN 'SNMP community-based configuration detected in an active SNMP daemon; verify effective configuration and migrate to SNMPv3 authPriv where required'
    elif (( users )); then
        result INFO 'SNMPv3 user directive detected; confirm authPriv, strong secrets and source restrictions'
    else
        result UNKNOWN 'SNMP daemon is running but security mode could not be determined from standard configuration paths'
    fi
}

check_firewall() {
    local state rules defaults
    if have ufw; then
        state="$(ufw status 2>/dev/null | awk -F: 'tolower($1) ~ /^status/ {gsub(/^[[:space:]]+/,"",$2); print tolower($2); exit}')"
        if [[ "$state" == active ]]; then
            defaults='not-readable'
            if [[ -r /etc/default/ufw ]]; then
                defaults="$(awk -F= '/^[[:space:]]*DEFAULT_(INPUT|OUTPUT|FORWARD)_POLICY=/ {gsub(/["[:space:]]/,"",$2); printf "%s%s=%s", sep, $1, $2; sep=","}' /etc/default/ufw)"
            fi
            result INFO "UFW is active; default policies=${defaults:-not-explicitly-found}; inspect 'ufw status verbose' and numbered rules for full validation"
            return
        fi
    fi
    if have firewall-cmd; then
        state="$(firewall-cmd --state 2>/dev/null)"
        [[ "$state" == running ]] && { result INFO 'firewalld is running; inspect active zones and services with firewall-cmd --get-active-zones and --list-all'; return; }
    fi
    if have nft; then
        rules="$(nft list ruleset 2>/dev/null)"
        if [[ -n "$rules" ]]; then result INFO 'nftables ruleset exists; inspect input/forward chain policies and interface coverage'; return; fi
    fi
    if have iptables; then
        rules="$(iptables -S 2>/dev/null)"
        if [[ -n "$rules" ]]; then
            if printf '%s\n' "$rules" | grep -Eq '^-P INPUT (DROP|REJECT)|^-P FORWARD (DROP|REJECT)'; then
                result INFO 'iptables has a DROP/REJECT default policy on INPUT/FORWARD'; return
            fi
            result WARN 'iptables rules exist but restrictive INPUT/FORWARD default policies were not confirmed'; return
        fi
    fi
    result WARN 'no active host firewall with a restrictive policy could be confirmed; verify whether another firewall layer protects this host'
}

check_update_reboot_flag() {
    if [[ -e /var/run/reboot-required ]]; then result WARN 'system indicates a reboot is required; review pending package/kernel updates';
    else result INFO 'no Debian-style reboot-required marker found; this does not prove the OS is fully patched'; fi
}

check_secure_boot() {
    local output
    [[ -d /sys/firmware/efi ]] || { result INFO 'system did not boot in UEFI mode; Secure Boot status is not applicable/detectable here'; return; }
    if ! have mokutil; then result UNKNOWN 'mokutil missing; install mokutil to inspect Secure Boot state'; return; fi
    output="$(mokutil --sb-state 2>&1)" || { result UNKNOWN 'mokutil could not read Secure Boot state'; return; }
    if printf '%s' "$output" | grep -qi 'SecureBoot enabled'; then result PASS 'Secure Boot enabled';
    elif printf '%s' "$output" | grep -qi 'SecureBoot disabled'; then result WARN 'Secure Boot disabled';
    else result UNKNOWN 'mokutil returned an unrecognized Secure Boot state'; fi
}

check_mac_framework() {
    local state output enforce_count

    if have getenforce; then
        state="$(getenforce 2>/dev/null)"
        case "$state" in
            Enforcing)
                result PASS 'SELinux is Enforcing'
                return
                ;;
            Permissive)
                result WARN 'SELinux is Permissive, not Enforcing'
                return
                ;;
            Disabled)
                ;;
        esac
    fi

    if have aa-status; then
        output="$(aa-status 2>/dev/null)"

        if printf '%s\n' "$output" | grep -Eqi 'apparmor module is loaded'; then
            enforce_count="$(printf '%s\n' "$output" |
                awk '/profiles are in enforce mode/ {
                    for (i=1; i<=NF; i++)
                        if ($i ~ /^[0-9]+$/) {print $i; exit}
                }')"

            if [[ "$enforce_count" =~ ^[0-9]+$ ]] && (( enforce_count > 0 )); then
                result PASS "AppArmor has $enforce_count enforced profile(s)"
            elif [[ "$enforce_count" == "0" ]]; then
                result WARN 'AppArmor is loaded but has zero enforced profiles'
            else
                result UNKNOWN 'AppArmor is loaded but enforced profile count could not be determined'
            fi
        else
            result WARN 'AppArmor enforcement could not be confirmed'
        fi
    else
        result WARN 'neither active SELinux enforcement nor AppArmor enforcement could be confirmed'
    fi
}

check_automatic_updates() {
    local active=0 installed=0
    is_active apt-daily-upgrade.timer && active=1
    is_active dnf-automatic.timer && active=1
    is_active dnf-automatic-install.timer && active=1
    is_active yum-cron.service && active=1
    have unattended-upgrade && installed=1
    have dnf-automatic && installed=1
    if (( active )); then result PASS 'an automatic update timer/service is active';
    elif (( installed )); then result WARN 'automatic update tool detected but no common active timer/service confirmed';
    else result WARN 'no common automatic security update mechanism detected'; fi
}

check_grub_password() {
    local count
    if [[ ! -d /etc/grub.d && ! -d /boot/grub2 ]]; then result UNKNOWN 'standard GRUB configuration paths not found'; return; fi
    count="$(grep -RihE '^[[:space:]]*password(_pbkdf2)?[[:space:]]' /etc/grub.d /etc/default/grub /boot/grub2/user.cfg 2>/dev/null | count_matching_lines)"
    if [[ "$count" -gt 0 ]]; then result INFO 'GRUB password directive detected; password/hash content intentionally not recorded';
    else result WARN 'no GRUB password directive detected; assess physical/console access and recovery requirements'; fi
}

check_critical_file_permissions() {
    local bad=0 f mode
    for f in /etc/passwd /etc/group /etc/shadow /etc/gshadow; do
        if [[ ! -e "$f" || ! -r "$f" ]]; then result UNKNOWN "cannot inspect $f; run with sufficient privileges"; return; fi
        mode="$(stat -c '%a' "$f" 2>/dev/null)" || { result UNKNOWN "stat failed for $f"; return; }
        case "$f:$mode" in
            /etc/passwd:644|/etc/group:644|/etc/shadow:600|/etc/shadow:640|/etc/shadow:0|/etc/gshadow:600|/etc/gshadow:640|/etc/gshadow:0) ;;
            *) bad=$((bad + 1));;
        esac
    done
    if (( bad == 0 )); then result PASS 'passwd/group are 0644 and shadow/gshadow are 0600, 0640 or 000';
    else result WARN "$bad critical account file(s) have non-standard permissions; review distribution-specific ownership/mode"; fi
}

check_suid_sgid() {
    local output count
    output="$(find /usr /bin /sbin /usr/local /opt -xdev -type f \( -perm -4000 -o -perm -2000 \) -print 2>/dev/null)"
    count="$(printf '%s\n' "$output" | count_matching_lines)"
    if [[ -z "$output" ]]; then result INFO 'no SUID/SGID files found in scanned paths';
    else result INFO "$count SUID/SGID file(s) found in common binary paths; review against package/vendor baseline (not automatically a failure)"; fi
}

check_world_writable_files() {
    local output count
    output="$(find /etc /usr/local /opt /var -xdev -type f -perm -0002 -print 2>/dev/null)"
    count="$(printf '%s\n' "$output" | count_matching_lines)"
    if [[ -z "$output" ]]; then result PASS 'no world-writable regular files found in scanned paths';
    else result WARN "$count world-writable file(s) found in /etc,/usr/local,/opt,/var; review ownership and purpose"; fi
}

check_cron_access() {
    local cron_state at_state f bad=0
    if [[ -f /etc/cron.allow ]]; then cron_state='cron.allow-present'
    elif [[ -f /etc/cron.deny ]]; then cron_state='cron.deny-only'
    else cron_state='no-cron-allow-or-deny'; fi
    if [[ -f /etc/at.allow ]]; then at_state='at.allow-present'
    elif [[ -f /etc/at.deny ]]; then at_state='at.deny-only'
    else at_state='no-at-allow-or-deny'; fi
    for f in /etc/cron.allow /etc/cron.deny /etc/at.allow /etc/at.deny; do
        [[ -e "$f" ]] || continue
        if have stat; then
            [[ "$(stat -c '%U:%G' "$f" 2>/dev/null)" == root:root ]] || bad=$((bad + 1))
            local mode
            mode="$(stat -c '%a' "$f" 2>/dev/null)"
            [[ "$mode" =~ ^[0-7]+$ ]] && (( (8#$mode & 0022) == 0 )) || bad=$((bad + 1))
        fi
    done
    if (( bad > 0 )); then result WARN "cron=$cron_state; at=$at_state; $bad access-control file ownership/permission issue(s) detected";
    elif [[ "$cron_state" == cron.allow-present && "$at_state" == at.allow-present ]]; then result INFO 'cron and at allow-lists exist; verify approved users and root:root restrictive permissions';
    else result WARN "cron=$cron_state; at=$at_state; review default access behavior and consider explicit allow-lists"; fi
}

check_linux_capabilities() {
    local output count
    if ! have getcap; then result UNKNOWN 'getcap missing; install libcap2-bin (Debian/Ubuntu) or libcap (RHEL/Fedora)'; return; fi
    output="$(getcap -r /usr/bin /usr/sbin /usr/local/bin /usr/local/sbin 2>/dev/null)"
    count="$(printf '%s\n' "$output" | count_matching_lines)"
    result INFO "$count file(s) with Linux capabilities detected in common binary paths; review each capability against operational need"
}

check_admin_groups() {
    local sudo_count=0 wheel_count=0 line
    if have getent; then
        line="$(getent group sudo 2>/dev/null | awk -F: '{print $4}')"
        [[ -n "$line" ]] && sudo_count="$(printf '%s' "$line" | awk -F, '{print NF}')"
        line="$(getent group wheel 2>/dev/null | awk -F: '{print $4}')"
        [[ -n "$line" ]] && wheel_count="$(printf '%s' "$line" | awk -F, '{print NF}')"
        result INFO "sudo group member count=${sudo_count}; wheel group member count=${wheel_count}; compare with approved administrator list"
    else
        result UNKNOWN 'getent is not available to inspect local admin groups';
