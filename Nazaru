#!/usr/bin/env bash
# Usage: bash Nazaru [report-file]
# Optional environment variable: REPORT_FILE=/path/to/report.txt
# Missing tools/permissions are reported as UNKNOWN

set -o pipefail
umask 077

REPORT_FILE="${1:-${REPORT_FILE:-./server_audit_report.txt}}"
REPORT_DIR="$(dirname -- "$REPORT_FILE")"
if ! mkdir -p -- "$REPORT_DIR" 2>/dev/null; then
    printf 'ERROR: cannot create report directory: %s\n' "$REPORT_DIR" >&2
    exit 2
fi
if ! touch -- "$REPORT_FILE" 2>/dev/null; then
    printf 'ERROR: cannot write report file: %s\n' "$REPORT_FILE" >&2
    exit 2
fi

LOCK_MODE="none"
LOCK_DIR="${REPORT_FILE}.lockdir"
if command -v flock >/dev/null 2>&1; then
    if ! { exec 9>>"${REPORT_FILE}.lock"; } 2>/dev/null; then
        printf 'ERROR: cannot open lock file: %s\n' "${REPORT_FILE}.lock" >&2
        exit 2
    fi
    if ! flock -n 9; then
        printf 'Another audit is already writing to %s\n' "$REPORT_FILE" >&2
        exit 1
    fi
    LOCK_MODE="flock"
else
    if ! mkdir -- "$LOCK_DIR" 2>/dev/null; then
        printf 'Another audit may be running (lock directory exists): %s\n' "$LOCK_DIR" >&2
        exit 1
    fi
    LOCK_MODE="mkdir"
    trap 'rmdir -- "$LOCK_DIR" 2>/dev/null || true' EXIT
fi

