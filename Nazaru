#!/usr/bin/env bash
# Nazaru 1.3.1 - Read-only Ubuntu Server security auditing tool
# Usage: ./nazaru.sh [-o report.txt] [-q] [-d] [-h] [-v] [-x [report.xml]]
# Legacy positional report path and REPORT_FILE environment variable remain supported.

set -o pipefail
umask 077

VERSION="1.3.6"
QUIET_MODE=0
DESCRIPTION_MODE=0
XML_ENABLED=0
XML_FILE="./nazaru_report.xml"
REPORT_FILE="${REPORT_FILE:-./server_audit_report.txt}"
POSITIONAL_REPORT=""

show_help() {
    cat <<EOF
Nazaru $VERSION - Read-only Linux Server Security Audit

Usage:
  $0 [OPTIONS] [report-file]

Options:
  -o FILE       Save the plain-text audit report to FILE
  -q            Quiet scan: show only WARN, FAIL and ERROR results on terminal
  -d            Include test descriptions in the report and terminal output
  -h            Show this help and exit
  -v            Show version and exit
  -x [FILE]     Generate an XML report (default: ./nazaru_report.xml)

Examples:
  $0
  $0 -o report.txt
  $0 -q -o report.txt
  $0 -d -o detailed_report.txt
  $0 -x
  $0 -o report.txt -x report.xml

The audit is read-only. It does not modify system configuration or perform network scans.
EOF
}

while (($#)); do
    case "$1" in
        -o)
            (($# >= 2)) || { printf 'ERROR: -o requires a report filename\n' >&2; exit 2; }
            REPORT_FILE="$2"; shift 2 ;;
        -q)
            QUIET_MODE=1; shift ;;
        -d)
            DESCRIPTION_MODE=1; shift ;;
        -h|--help)
            show_help; exit 0 ;;
        -v|--version)
            printf 'Nazaru %s\n' "$VERSION"; exit 0 ;;
        -x)
            XML_ENABLED=1
            if (($# >= 2)) && [[ "$2" != -* ]]; then XML_FILE="$2"; shift 2; else shift; fi ;;
        --)
            shift
            if (($#)); then
                [[ -z "$POSITIONAL_REPORT" ]] || { printf 'ERROR: only one positional report path is supported\n' >&2; exit 2; }
                POSITIONAL_REPORT="$1"; shift
            fi
            (($# == 0)) || { printf 'ERROR: unexpected argument(s)\n' >&2; exit 2; } ;;
        -* )
            printf 'ERROR: unknown option: %s\n' "$1" >&2
            printf 'Use -h to see available options.\n' >&2
            exit 2 ;;
        *)
            [[ -z "$POSITIONAL_REPORT" ]] || { printf 'ERROR: only one positional report path is supported\n' >&2; exit 2; }
            POSITIONAL_REPORT="$1"; shift ;;
    esac
done
[[ -n "$POSITIONAL_REPORT" ]] && REPORT_FILE="$POSITIONAL_REPORT"

if (( XML_ENABLED )) && [[ "$XML_FILE" == "$REPORT_FILE" ]]; then
    printf 'ERROR: text and XML report paths must be different\n' >&2
    exit 2
fi

REPORT_DIR="$(dirname -- "$REPORT_FILE")"
if ! mkdir -p -- "$REPORT_DIR" 2>/dev/null; then
    printf 'ERROR: cannot create report directory: %s\n' "$REPORT_DIR" >&2
    exit 2
fi
if ! touch -- "$REPORT_FILE" 2>/dev/null; then
    printf 'ERROR: cannot write report file: %s\n' "$REPORT_FILE" >&2
    exit 2
fi
if (( XML_ENABLED )); then
    XML_DIR="$(dirname -- "$XML_FILE")"
    if ! mkdir -p -- "$XML_DIR" 2>/dev/null || ! : > "$XML_FILE" 2>/dev/null; then
        printf 'ERROR: cannot create XML report: %s\n' "$XML_FILE" >&2
        exit 2
    fi
fi

LOCK_MODE="none"
LOCK_DIR="${REPORT_FILE}.lockdir"
if command -v flock >/dev/null 2>&1; then
    if ! { exec 9>>"${REPORT_FILE}.lock"; } 2>/dev/null; then
        printf 'ERROR: cannot open lock file: %s\n' "${REPORT_FILE}.lock" >&2
        exit 2
    fi
    if ! flock -n 9; then
        printf 'Another audit is already writing to %s\n' "$REPORT_FILE" >&2
        exit 1
    fi
    LOCK_MODE="flock"
else
    if ! mkdir -- "$LOCK_DIR" 2>/dev/null; then
        printf 'Another audit may be running (lock directory exists): %s\n' "$LOCK_DIR" >&2
        exit 1
    fi
    LOCK_MODE="mkdir"
    trap 'rmdir -- "$LOCK_DIR" 2>/dev/null || true' EXIT
fi
if ! : > "$REPORT_FILE" 2>/dev/null; then
    printf 'ERROR: cannot initialize report file: %s\n' "$REPORT_FILE" >&2
    exit 2
fi

show_banner() {
    printf '\033[36m'
    cat <<'EOF'
███╗   ██╗  █████╗  ███████╗  █████╗  ██████╗  ██╗   ██╗
████╗  ██║ ██╔══██╗ ╚══███╔╝ ██╔══██╗ ██╔══██╗ ██║   ██║
██╔██╗ ██║ ███████║   ███╔╝  ███████║ ██████╔╝ ██║   ██║
██║╚██╗██║ ██╔══██║  ███╔╝   ██╔══██║ ██╔══██╗ ██║   ██║
██║ ╚████║ ██║  ██║ ███████╗ ██║  ██║ ██║  ██║ ╚██████╔╝
╚═╝  ╚═══╝ ╚═╝  ╚═╝ ╚══════╝ ╚═╝  ╚═╝ ╚═╝  ╚═╝  ╚═════╝
