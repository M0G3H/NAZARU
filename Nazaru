check_remote_log_forwarding() {
    local count=0 f

    for f in /etc/rsyslog.conf /etc/rsyslog.d/*; do
        [[ -f "$f" && -r "$f" ]] || continue

        count=$((count + $(
            awk '
                /^[[:space:]]*#/ {next}
                /^[[:space:]]*$/ {next}
                {
                    line=$0
                    sub(/[[:space:]]+#.*/, "", line)
                    if (line ~ /(^|[[:space:]])@@?[^[:space:]]+/)
                        n++
                }
                END {print n+0}
            ' "$f" 2>/dev/null
        )))
    done

    if (( count > 0 )); then
        result INFO "$count possible rsyslog remote destination(s) detected; verify destination, TLS, authentication and delivery"
