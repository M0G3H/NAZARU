check_backup_immutability() {
    local matches
    matches="$(ps -eo comm= 2>/dev/null | grep -Eic '(^|/)(restic|borg|kopia|duplicity|veeam|bacula-fd|bareos-fd|commvault)$')"
    if (( matches > 0 )); then result INFO "$matches common backup-related process(es) detected; immutable/offline storage and retention lock cannot be proven from this host";
    else result UNKNOWN 'no common backup process detected; backup may be agentless or externally managed; verify immutable/offline copies with the backup platform'; fi
}

check_restore_test_evidence() {
