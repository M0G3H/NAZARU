}

check_kernel_security_parameters() {
    local key value
    local failed=0
    local checked=0

    if ! have sysctl; then
        result UNKNOWN "sysctl command is unavailable"
        return
    fi

    local -a settings=(
        "kernel.kptr_restrict:1"
        "kernel.dmesg_restrict:1"
        "net.ipv4.conf.all.accept_redirects:0"
        "net.ipv4.conf.default.accept_redirects:0"
        "net.ipv4.conf.all.send_redirects:0"
        "net.ipv4.conf.default.send_redirects:0"
        "net.ipv4.conf.all.accept_source_route:0"
        "net.ipv4.conf.default.accept_source_route:0"
        "net.ipv4.tcp_syncookies:1"
    )

    for key in "${settings[@]}"; do
        value="${key##*:}"
        key="${key%:*}"

        local actual
        actual=$(sysctl -n "$key" 2>/dev/null) || continue

        checked=$((checked + 1))

        if [[ "$actual" != "$value" ]]; then
            failed=$((failed + 1))
        fi
    done

    if (( checked == 0 )); then
        result UNKNOWN "Unable to read kernel security parameters"
    elif (( failed == 0 )); then
        result PASS "All $checked supported kernel security parameters have expected values"
    else
        result WARN "$failed of $checked kernel security parameters do not have expected values"
    fi
}

check_filesystem_mount_options() {
    local target options
    local missing=0
    local checked=0

    if ! have findmnt; then
        result UNKNOWN "findmnt command is unavailable"
        return
    fi

    for target in /tmp /var/tmp /dev/shm; do
        if ! findmnt --mountpoint "$target" >/dev/null 2>&1; then
            continue
        fi

        checked=$((checked + 1))
        options=$(findmnt -n -o OPTIONS --mountpoint "$target" 2>/dev/null)

        if [[ -z "$options" ]]; then
            result UNKNOWN "Unable to read mount options for $target"
            return
        fi

        [[ ",$options," == *",nodev,"* ]] || missing=$((missing + 1))
        [[ ",$options," == *",nosuid,"* ]] || missing=$((missing + 1))
    done

    if (( checked == 0 )); then
        result UNKNOWN "No separate mount points found for /tmp, /var/tmp, or /dev/shm"
    elif (( missing == 0 )); then
        result PASS "Checked temporary mount points have nodev and nosuid"
    else
        result WARN "$missing required mount options are missing across $checked mount points"
    fi
}

check_auditd_configuration() {
    local status rules enabled

    if ! have auditctl; then
        result UNKNOWN "auditctl command is unavailable"
        return
    fi

    if have systemctl; then
        if ! is_active auditd; then
            result WARN "auditd service is not active"
            return
        fi
    else
        result UNKNOWN "systemctl command is unavailable"
        return
    fi

    status=$(auditctl -s 2>/dev/null) || {
        result UNKNOWN "Unable to read audit subsystem status"
        return
    }

    enabled=$(awk '$1 == "enabled" {print $2; exit}' <<< "$status")

    if [[ "$enabled" != "1" && "$enabled" != "2" ]]; then
        result WARN "Kernel auditing is not enabled"
        return
    fi

    rules=$(auditctl -l 2>/dev/null) || {
        result UNKNOWN "Unable to read audit rules"
        return
    }

    if [[ -z "$rules" || "$rules" == *"No rules"* ]]; then
        result WARN "No audit rules are configured"
        return
    fi

    result PASS "auditd is active, kernel auditing is enabled, and audit rules are present"
}

check_password_complexity() {
    local file line found=0
    local minlen=""
    local files=(
        /etc/pam.d/common-password
        /etc/pam.d/system-auth
        /etc/pam.d/password-auth
    )

    for file in "${files[@]}"; do
        [[ -r "$file" ]] || continue

        while IFS= read -r line; do
            [[ "$line" =~ ^[[:space:]]*# ]] && continue

            if [[ "$line" =~ pam_pwquality\.so|pam_cracklib\.so ]]; then
                found=1

                if [[ "$line" =~ minlen=([0-9]+) ]]; then
                    minlen="${BASH_REMATCH[1]}"
                fi
            fi
        done < "$file"
    done

    if (( found == 0 )); then
        result WARN "No active PAM password complexity module was found"
    elif [[ -z "$minlen" ]]; then
        result WARN "Password complexity module found, but minlen could not be verified"
    elif (( minlen >= 12 )); then
        result PASS "Password complexity module is configured with minlen=$minlen"
    else
        result WARN "Password complexity minimum length is $minlen; expected at least 12"
    fi
}

check_password_history() {
    local file line remember=""
    local found=0
    local files=(
        /etc/pam.d/common-password
        /etc/pam.d/system-auth
        /etc/pam.d/password-auth
    )

    for file in "${files[@]}"; do
        [[ -r "$file" ]] || continue

        while IFS= read -r line; do
            [[ "$line" =~ ^[[:space:]]*# ]] && continue

            if [[ "$line" =~ pam_pwhistory\.so|pam_unix\.so ]]; then
                if [[ "$line" =~ remember=([0-9]+) ]]; then
                    found=1
                    remember="${BASH_REMATCH[1]}"
                fi
            fi
        done < "$file"
    done

    if (( found == 0 )); then
        result WARN "Password history enforcement was not found in the checked PAM files"
    elif (( remember >= 5 )); then
        result PASS "Password history is configured to remember $remember passwords"
    else
        result WARN "Password history is configured for $remember passwords; expected at least 5"
    fi
}

check_password_hashing_algorithm() {
    local method

    if [[ ! -r /etc/login.defs ]]; then
        result UNKNOWN "Cannot read /etc/login.defs"
        return
    fi

    method=$(awk 'toupper($1) == "ENCRYPT_METHOD" {value=toupper($2)} END {print value}' /etc/login.defs)

    case "$method" in
        YESCRYPT|SHA512)
            result PASS "Password hashing algorithm is configured as $method"
            ;;
        SHA256)
            result WARN "Password hashing algorithm is SHA256"
            ;;
        MD5|DES|BIGCRYPT)
            result FAIL "Weak password hashing algorithm configured: $method"
            ;;
        "")
            result UNKNOWN "ENCRYPT_METHOD is not explicitly configured in /etc/login.defs"
            ;;
        *)
            result UNKNOWN "Unrecognized password hashing algorithm: $method"
            ;;
    esac
}

check_account_inactivity() {
    local inactive

    if ! have useradd; then
        result UNKNOWN "useradd command is unavailable"
        return
    fi

    inactive=$(useradd -D 2>/dev/null | awk -F= '$1 == "INACTIVE" {print $2; exit}')

    if [[ -z "$inactive" ]]; then
        result UNKNOWN "Unable to determine the default account inactivity setting"
    elif [[ "$inactive" == "-1" ]]; then
        result WARN "Default account inactivity expiration is disabled"
    elif [[ "$inactive" =~ ^[0-9]+$ ]] && (( inactive <= 30 )); then
        result PASS "Default account inactivity period is $inactive days"
    elif [[ "$inactive" =~ ^[0-9]+$ ]]; then
        result WARN "Default account inactivity period is $inactive days; expected 30 or fewer"
    else
        result UNKNOWN "Unrecognized account inactivity value: $inactive"
    fi
}

check_default_umask() {
    local file line value=""
    local files=(
        /etc/login.defs
        /etc/profile
        /etc/bash.bashrc
    )

    for file in "${files[@]}"; do
        [[ -r "$file" ]] || continue

        while IFS= read -r line; do
            [[ "$line" =~ ^[[:space:]]*# ]] && continue

            if [[ "$line" =~ ^[[:space:]]*UMASK[[:space:]]+([0-7]{3,4}) ]]; then
                value="${BASH_REMATCH[1]}"
            fi
        done < "$file"
    done

    if [[ -z "$value" ]]; then
        result UNKNOWN "No explicit UMASK setting found in checked configuration files"
        return
    fi

    value="${value#0}"

    if [[ ! "$value" =~ ^[0-7]{3}$ ]]; then
        result UNKNOWN "Unrecognized UMASK value"
        return
    fi

    local numeric=$((8#$value))

    if (( (numeric & 002) == 0 && (numeric & 020) == 0 )); then
        result PASS "UMASK $value prevents group and world write permissions by default"
    else
        result WARN "UMASK $value may allow group or world write permissions"
    fi
}

check_time_synchronization() {
    local synchronized=""

    if have timedatectl; then
        synchronized=$(timedatectl show -p NTPSynchronized --value 2>/dev/null)

        if [[ "$synchronized" == "yes" ]]; then
            result PASS "System time synchronization is active"
            return
        fi
    fi

    if have systemctl; then
        if is_active systemd-timesyncd || is_active chronyd || is_active chrony || is_active ntp || is_active ntpd; then
            result WARN "Time synchronization service is active, but synchronization could not be verified"
            return
        fi
    fi

    if [[ -z "$synchronized" ]]; then
        result UNKNOWN "Unable to verify system time synchronization"
    else
        result WARN "System time is not synchronized"
    fi
}

check_ssh_cryptographic_settings() {
    local config ciphers macs kex
    local weak=0

    if ! have sshd; then
        result UNKNOWN "sshd command is unavailable"
        return
    fi

    config=$(sshd -T 2>/dev/null) || {
        result UNKNOWN "Unable to retrieve effective SSH configuration"
        return
    }

    ciphers=$(awk '$1 == "ciphers" {$1=""; sub(/^[[:space:]]+/, ""); print; exit}' <<< "$config")
    macs=$(awk '$1 == "macs" {$1=""; sub(/^[[:space:]]+/, ""); print; exit}' <<< "$config")
    kex=$(awk '$1 == "kexalgorithms" {$1=""; sub(/^[[:space:]]+/, ""); print; exit}' <<< "$config")

    if [[ -z "$ciphers" || -z "$macs" || -z "$kex" ]]; then
        result UNKNOWN "Unable to identify effective SSH cryptographic settings"
        return
    fi

    if grep -Eqi '(^|,)(3des-cbc|aes(128|192|256)-cbc|arcfour[^,]*|blowfish-cbc|cast128-cbc)(,|$)' <<< "$ciphers"; then
        weak=$((weak + 1))
    fi

    if grep -Eqi '(^|,)(hmac-sha1|hmac-md5|hmac-md5-96|hmac-sha1-96|umac-64)(,|$)' <<< "$macs"; then
        weak=$((weak + 1))
    fi

    if grep -Eqi '(^|,)(diffie-hellman-group1-sha1|diffie-hellman-group14-sha1|diffie-hellman-group-exchange-sha1)(,|$)' <<< "$kex"; then
        weak=$((weak + 1))
    fi

    if (( weak == 0 )); then
        result PASS "No identified weak SSH ciphers, MACs, or key exchange algorithms were found"
    else
        result WARN "Weak SSH cryptographic algorithms were detected in $weak configuration categories"
    fi
}

check_kernel_module_restrictions() {
    local module normalized loaded config
    local available=0
    local unrestricted=0

    if ! have modprobe || ! have modinfo; then
        result UNKNOWN "modprobe or modinfo command is unavailable"
        return
    fi

    config=$(modprobe -c 2>/dev/null) || {
        result UNKNOWN "Unable to read effective module configuration"
        return
    }

    local -a modules=(
        cramfs
        freevxfs
        jffs2
        hfs
        hfsplus
        udf
    )

    for module in "${modules[@]}"; do
        if ! modinfo "$module" >/dev/null 2>&1; then
            continue
        fi

        available=$((available + 1))
        normalized="${module//-/_}"

        loaded=0
        if [[ -r /proc/modules ]] && awk -v m="$normalized" '$1 == m {found=1} END {exit !found}' /proc/modules; then
            loaded=1
        fi

        if (( loaded == 1 )); then
            unrestricted=$((unrestricted + 1))
            continue
        fi

        if ! awk -v m="$normalized" '
            $1 == "install" {
                name=$2
                gsub(/-/, "_", name)
                if (name == m && ($3 == "/bin/true" || $3 == "/bin/false" || $3 == "true" || $3 == "false")) {
                    found=1
                }
            }
            END {exit !found}
        ' <<< "$config"; then
            unrestricted=$((unrestricted + 1))
        fi
    done

    if (( available == 0 )); then
        result UNKNOWN "None of the checked kernel modules are available"
    elif (( unrestricted == 0 )); then
        result PASS "All $available available restricted filesystem modules are disabled"
    else
        result WARN "$unrestricted of $available available restricted filesystem modules are not adequately disabled"
    fi
}

check_aslr_configuration() {
    local value

    if ! have sysctl; then
        result UNKNOWN "sysctl command is unavailable"
        return
    fi

    value=$(sysctl -n kernel.randomize_va_space 2>/dev/null) || {
        result UNKNOWN "Unable to read ASLR configuration"
        return
    }

    if [[ "$value" == "2" ]]; then
        result PASS "ASLR is fully enabled"
    elif [[ "$value" == "1" ]]; then
        result WARN "ASLR is partially enabled; expected value is 2"
    elif [[ "$value" == "0" ]]; then
        result FAIL "ASLR is disabled"
    else
        result UNKNOWN "Unrecognized ASLR setting: $value"
    fi
}

check_core_dump_restrictions() {
    local suid_value config storage process_size

    if ! have sysctl; then
        result UNKNOWN "sysctl command is unavailable"
        return
    fi

    suid_value=$(sysctl -n fs.suid_dumpable 2>/dev/null) || {
        result UNKNOWN "Unable to read fs.suid_dumpable"
        return
    }

    if [[ "$suid_value" != "0" ]]; then
        result WARN "fs.suid_dumpable is $suid_value; expected 0"
        return
    fi

    if ! have systemd-analyze; then
        result UNKNOWN "systemd-analyze command is unavailable"
        return
    fi

    config=$(systemd-analyze cat-config systemd/coredump.conf 2>/dev/null) || {
        result UNKNOWN "Unable to read effective systemd-coredump configuration"
        return
    }

    storage=$(awk '
        /^[[:space:]]*#/ {next}
        /^[[:space:]]*Storage[[:space:]]*=/ {
            sub(/^[^=]*=/, "")
            gsub(/[[:space:]]/, "")
            value=tolower($0)
        }
        END {print value}
    ' <<< "$config")

    process_size=$(awk '
        /^[[:space:]]*#/ {next}
        /^[[:space:]]*ProcessSizeMax[[:space:]]*=/ {
            sub(/^[^=]*=/, "")
            gsub(/[[:space:]]/, "")
            value=tolower($0)
        }
        END {print value}
    ' <<< "$config")

    if [[ "$storage" == "none" || "$process_size" == "0" ]]; then
        result PASS "Core dump restrictions are configured"
    else
        result WARN "Core dump storage or processing is not explicitly disabled"
    fi
}

check_ptrace_restrictions() {
    local value

    if ! have sysctl; then
        result UNKNOWN "sysctl command is unavailable"
        return
    fi

    value=$(sysctl -n kernel.yama.ptrace_scope 2>/dev/null) || {
        result UNKNOWN "Yama ptrace_scope is unavailable"
        return
    }

    if [[ "$value" =~ ^[0-3]$ ]] && (( value >= 1 )); then
        result PASS "Ptrace restrictions are enabled with scope $value"
    elif [[ "$value" == "0" ]]; then
        result WARN "Ptrace restrictions are disabled"
    else
        result UNKNOWN "Unrecognized ptrace_scope value: $value"
    fi
}

check_ipv6_security() {
    local key value
    local failed=0
    local checked=0

    if ! have sysctl; then
        result UNKNOWN "sysctl command is unavailable"
        return
    fi

    local -a settings=(
        "net.ipv6.conf.all.accept_redirects"
        "net.ipv6.conf.default.accept_redirects"
        "net.ipv6.conf.all.accept_source_route"
        "net.ipv6.conf.default.accept_source_route"
    )

    for key in "${settings[@]}"; do
        value=$(sysctl -n "$key" 2>/dev/null) || continue

        checked=$((checked + 1))

        if [[ "$value" != "0" ]]; then
            failed=$((failed + 1))
        fi
    done

    if (( checked == 0 )); then
        result UNKNOWN "IPv6 security parameters are unavailable or IPv6 is unsupported"
    elif (( failed == 0 )); then
        result PASS "All $checked checked IPv6 security parameters are configured securely"
    else
        result WARN "$failed of $checked IPv6 security parameters do not have expected values"
    fi
}

check_usb_storage_restrictions() {
    local config loaded

    if ! have modprobe || ! have modinfo; then
        result UNKNOWN "modprobe or modinfo command is unavailable"
        return
    fi

    if ! modinfo usb-storage >/dev/null 2>&1; then
        result UNKNOWN "USB storage module is unavailable"
        return
    fi

    config=$(modprobe -c 2>/dev/null) || {
        result UNKNOWN "Unable to read effective module configuration"
        return
    }

    loaded=0
    if [[ -r /proc/modules ]] && awk '$1 == "usb_storage" {found=1} END {exit !found}' /proc/modules; then
        loaded=1
    fi

    if (( loaded == 1 )); then
        result WARN "USB storage module is currently loaded"
        return
    fi

    if awk '
        $1 == "install" {
            name=$2
            gsub(/-/, "_", name)
            if (name == "usb_storage" && ($3 == "/bin/true" || $3 == "/bin/false" || $3 == "true" || $3 == "false")) {
                found=1
            }
        }
        END {exit !found}
    ' <<< "$config"; then
        result PASS "USB storage module loading is disabled"
    else
        result WARN "USB storage module is not explicitly disabled"
    fi
}

check_disk_encryption() {
    local root_source types

    if ! have findmnt || ! have lsblk; then
        result UNKNOWN "findmnt or lsblk command is unavailable"
        return
    fi

    root_source=$(findmnt -n -o SOURCE / 2>/dev/null) || {
        result UNKNOWN "Unable to identify root filesystem source"
        return
    }

    if [[ -z "$root_source" || "$root_source" != /dev/* ]]; then
        result UNKNOWN "Root filesystem source is not a directly identifiable block device"
        return
    fi

    types=$(lsblk -s -n -o TYPE "$root_source" 2>/dev/null) || {
        result UNKNOWN "Unable to inspect root filesystem block device"
        return
    }

    if grep -qx "crypt" <<< "$types"; then
        result PASS "Root filesystem is backed by a detected encrypted block device"
    else
        result WARN "No encrypted block device was detected in the root filesystem chain"
    fi
}

check_package_integrity() {
    local output status

    if ! have dpkg; then
        result UNKNOWN "dpkg command is unavailable"
        return
    fi

    output=$(dpkg -V 2>&1)
    status=$?

    if (( status != 0 )); then
        result UNKNOWN "Package integrity verification could not be completed"
    elif [[ -z "$output" ]]; then
        result PASS "No package file integrity differences were reported by dpkg"
    else
        result WARN "Package integrity verification reported modified or missing files"
    fi
}

