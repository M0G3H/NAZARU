xml_escape() {
    local value="$1"
    value=${value//&/\&amp;}
    value=${value//</\&lt;}
    value=${value//>/\&gt;}
    value=${value//\"/\&quot;}
    value=${value//\'/\&apos;}
    printf '%s' "$value"
}

run_check() {
    local name="$1" fn="$2" cis_id="$3" cis_level="$4" category="$5"
    local raw rc status detail prefix status_tag color result_line
    INDEX=$((INDEX + 1))

    raw="$($fn 2>&1)"
    rc=$?
    if (( rc != 0 )); then
        status='ERROR'
        detail="test function returned non-zero exit code $rc"
    elif [[ "$raw" == *'|'* ]]; then
        status="${raw%%|*}"
        detail="${raw#*|}"
        case "$status" in PASS|WARN|FAIL|INFO|UNKNOWN|ERROR) ;;
            *) status='ERROR'; detail='test returned an invalid status format' ;;
        esac
    else
        status='ERROR'
        detail='test returned no valid STATUS|DETAIL result'
    fi

    detail="${detail//$'\n'/ }"
    detail="${detail//$'\r'/ }"
    detail="${detail//|/\/}"
    if [[ "${detail,,}" == 'manual review required:'* ]]; then
        detail="${detail#*:}"
        detail="${detail# }"
    fi

    case "$status" in
        PASS) PASS_COUNT=$((PASS_COUNT + 1));;
        WARN) WARN_COUNT=$((WARN_COUNT + 1));;
        FAIL) FAIL_COUNT=$((FAIL_COUNT + 1));;
        INFO) INFO_COUNT=$((INFO_COUNT + 1));;
        UNKNOWN) UNKNOWN_COUNT=$((UNKNOWN_COUNT + 1));;
        ERROR) ERROR_COUNT=$((ERROR_COUNT + 1));;
    esac

    [[ "$cis_level" == none ]] && cis_level='N/A'
    name="${name#CIS }"
    printf -v name_field "%-*s" "$NAME_FIELD_WIDTH" "- [$name]"
    prefix="${name_field} [CIS-Level=$cis_level] [CIS-ID=\"$cis_id\"] "
    status_tag="[STATUS=$status]"
    result_line="${prefix}${status_tag}"
    if (( DESCRIPTION_MODE )); then
        result_line+=" [$detail]"
    fi

    case "$status" in
        PASS)    color='\033[32m' ;;
        WARN)    color='\033[31m' ;;
        FAIL)    color='\033[1;31m' ;;
        INFO)    color='\033[36m' ;;
        UNKNOWN) color='\033[33m' ;;
        ERROR)   color='\033[35m' ;;
        *)       color='\033[0m' ;;
    esac

    log_result "$result_line" "$prefix" "$status_tag" "$detail" "$color" "$status"
    RESULT_NAMES+=("$name")
    RESULT_CATEGORIES+=("$category")
    RESULT_CIS_IDS+=("$cis_id")
    RESULT_CIS_LEVELS+=("$cis_level")
    RESULT_STATUSES+=("$status")
    RESULT_DETAILS+=("$detail")
}

CATEGORIES=(
    'Authentication & Account Security'
    'Network & Service Security'
    'Filesystem & Permissions'
    'Kernel & Boot Security'
    'Logging, Auditing & Monitoring'
    'System Integrity & Maintenance'
    'System Configuration & Compliance'
)

# Run checks grouped by category while retaining the source arrays as the single
# source of truth for test names, functions, CIS IDs and profile levels.
for category in "${CATEGORIES[@]}"; do
    category_has_tests=0
    for i in "${!TEST_FUNCTIONS[@]}"; do
        current_category="$(test_category "${TEST_FUNCTIONS[$i]}" "${TEST_NAMES[$i]}")"
        [[ "$current_category" == "$category" ]] && category_has_tests=1 && break
    done
    (( category_has_tests )) || continue
    log_line "[+] $category"
    log_line '-----------------------'
    for i in "${!TEST_FUNCTIONS[@]}"; do
        current_category="$(test_category "${TEST_FUNCTIONS[$i]}" "${TEST_NAMES[$i]}")"
        [[ "$current_category" == "$category" ]] || continue
        run_check "${TEST_NAMES[$i]}" "${TEST_FUNCTIONS[$i]}" "${TEST_CIS_IDS[$i]}" "${TEST_CIS_LEVELS[$i]}" "$category"
    done
    log_line ''
done

log_line '----------------------------------------------------------------------'
log_line "SUMMARY | TOTAL=$TOTAL_TESTS | PASS=$PASS_COUNT | WARN=$WARN_COUNT | FAIL=$FAIL_COUNT | INFO=$INFO_COUNT | UNKNOWN=$UNKNOWN_COUNT | ERROR=$ERROR_COUNT"
log_line 'END OF AUDIT'
log_line '======================================================================'

if (( XML_ENABLED )); then
    {
        printf '<?xml version="1.0" encoding="UTF-8"?>\n'
        printf '<nazaru-report version="%s">\n' "$(xml_escape "$VERSION")"
        printf '  <metadata>\n'
        printf '    <timestamp>%s</timestamp>\n' "$(xml_escape "$RUN_TIME")"
        printf '    <hostname>%s</hostname>\n' "$(xml_escape "$HOST_NAME")"
        printf '    <operating-system>%s</operating-system>\n' "$(xml_escape "$DISTRO_NAME")"
        printf '    <os-id>%s</os-id>\n' "$(xml_escape "$OS_ID")"
        printf '    <kernel>%s</kernel>\n' "$(xml_escape "$(uname -r 2>/dev/null || printf unknown)")"
        printf '    <read-only>true</read-only>\n'
        printf '  </metadata>\n'
        if [[ "$OS_ID" != ubuntu ]]; then
            printf '  <warning>%s</warning>\n' "$(xml_escape "$OS_WARNING")"
        fi
        printf '  <summary total="%s" pass="%s" warn="%s" fail="%s" info="%s" unknown="%s" error="%s" />\n' \
            "$TOTAL_TESTS" "$PASS_COUNT" "$WARN_COUNT" "$FAIL_COUNT" "$INFO_COUNT" "$UNKNOWN_COUNT" "$ERROR_COUNT"
        printf '  <results>\n'
        for j in "${!RESULT_NAMES[@]}"; do
            printf '    <test category="%s" name="%s" cis-level="%s" cis-id="%s" status="%s">%s</test>\n' \
                "$(xml_escape "${RESULT_CATEGORIES[$j]}")" \
                "$(xml_escape "${RESULT_NAMES[$j]}")" \
                "$(xml_escape "${RESULT_CIS_LEVELS[$j]}")" \
                "$(xml_escape "${RESULT_CIS_IDS[$j]}")" \
                "$(xml_escape "${RESULT_STATUSES[$j]}")" \
                "$(xml_escape "${RESULT_DETAILS[$j]}")"
        done
        printf '  </results>\n'
        printf '</nazaru-report>\n'
    } > "$XML_FILE" || { printf 'ERROR: failed writing XML report: %s\n' "$XML_FILE" >&2; exit 2; }
    if (( ! QUIET_MODE )); then printf 'XML report saved: %s\n' "$XML_FILE"; fi
fi

# Return success if the audit completed. Findings are reported in the file;
# they do not make the audit process itself fail.
exit 0
