check_ipv6_security() {
    local key value
    local failed=0
    local checked=0

    if ! have sysctl; then
        result UNKNOWN "sysctl command is unavailable"
        return
    fi

    local -a settings=(
        "net.ipv6.conf.all.accept_redirects"
        "net.ipv6.conf.default.accept_redirects"
        "net.ipv6.conf.all.accept_source_route"
        "net.ipv6.conf.default.accept_source_route"
    )

    for key in "${settings[@]}"; do
        value=$(sysctl -n "$key" 2>/dev/null) || continue

        checked=$((checked + 1))

        if [[ "$value" != "0" ]]; then
            failed=$((failed + 1))
        fi
    done

    if (( checked == 0 )); then
        result UNKNOWN "IPv6 security parameters are unavailable or IPv6 is unsupported"
    elif (( failed == 0 )); then
        result PASS "All $checked checked IPv6 security parameters are configured securely"
    else
        result WARN "$failed of $checked IPv6 security parameters do not have expected values"
    fi
}

check_usb_storage_restrictions() {
    local config loaded

    if ! have modprobe || ! have modinfo; then
        result UNKNOWN "modprobe or modinfo command is unavailable"
        return
    fi

    if ! modinfo usb-storage >/dev/null 2>&1; then
        result UNKNOWN "USB storage module is unavailable"
        return
    fi

    config=$(modprobe -c 2>/dev/null) || {
        result UNKNOWN "Unable to read effective module configuration"
        return
    }

    loaded=0
    if [[ -r /proc/modules ]] && awk '$1 == "usb_storage" {found=1} END {exit !found}' /proc/modules; then
        loaded=1
    fi

    if (( loaded == 1 )); then
        result WARN "USB storage module is currently loaded"
        return
    fi

    if awk '
        $1 == "install" {
            name=$2
            gsub(/-/, "_", name)
            if (name == "usb_storage" && ($3 == "/bin/true" || $3 == "/bin/false" || $3 == "true" || $3 == "false")) {
                found=1
            }
        }
        END {exit !found}
    ' <<< "$config"; then
        result PASS "USB storage module loading is disabled"
    else
        result WARN "USB storage module is not explicitly disabled"
    fi
}

check_disk_encryption() {
    local root_source types

    if ! have findmnt || ! have lsblk; then
        result UNKNOWN "findmnt or lsblk command is unavailable"
        return
    fi

    root_source=$(findmnt -n -o SOURCE / 2>/dev/null) || {
        result UNKNOWN "Unable to identify root filesystem source"
        return
    }

    if [[ -z "$root_source" || "$root_source" != /dev/* ]]; then
        result UNKNOWN "Root filesystem source is not a directly identifiable block device"
        return
    fi

    types=$(lsblk -s -n -o TYPE "$root_source" 2>/dev/null) || {
        result UNKNOWN "Unable to inspect root filesystem block device"
        return
    }

    if grep -qx "crypt" <<< "$types"; then
        result PASS "Root filesystem is backed by a detected encrypted block device"
    else
        result WARN "No encrypted block device was detected in the root filesystem chain"
    fi
}

check_package_integrity() {
    local output status

    if ! have dpkg; then
        result UNKNOWN "dpkg command is unavailable"
        return
    fi

    output=$(dpkg -V 2>&1)
    status=$?

    if (( status != 0 )); then
        result UNKNOWN "Package integrity verification could not be completed"
    elif [[ -z "$output" ]]; then
        result PASS "No package file integrity differences were reported by dpkg"
    else
        result WARN "Package integrity verification reported modified or missing files"
    fi
}


check_legal_login_banners() {
    local f missing=0 bad=0 found=0 mode owner
    for f in /etc/issue /etc/issue.net /etc/motd; do
        if [[ ! -e "$f" ]]; then
            missing=$((missing + 1))
            continue
        fi
        found=$((found + 1))
        if [[ ! -s "$f" ]]; then missing=$((missing + 1)); fi
        if have stat; then
            mode="$(stat -c '%a' "$f" 2>/dev/null)"
            owner="$(stat -c '%U:%G' "$f" 2>/dev/null)"
            [[ "$owner" == root:root ]] || bad=$((bad + 1))
            [[ "$mode" =~ ^[0-7]+$ ]] && (( (8#$mode & 0022) == 0 )) || bad=$((bad + 1))
        fi
    done
    local ssh_banner
    ssh_banner="$(sshd_value banner 2>/dev/null)"
    if (( found == 0 )); then
        result WARN 'no standard local/remote login banner files were found'
    elif (( bad > 0 )); then
        result WARN "$found banner file(s) found; $bad ownership/permission issue(s); sshd Banner=${ssh_banner:-not-configured}"
    elif [[ -n "$ssh_banner" && "$ssh_banner" != none ]]; then
        result PASS "$found standard banner file(s) found with restrictive ownership/permissions; SSH Banner=$ssh_banner"
    else
        result INFO "$found standard banner file(s) found with restrictive ownership/permissions; SSH Banner is not configured"
    fi
}

check_gdm_configuration() {
    local status config banner_enabled banner_text
    if ! have dpkg-query; then
        result UNKNOWN 'dpkg-query unavailable; cannot determine whether GDM is installed'
        return
    fi
    status="$(dpkg-query -W -f='${db:Status-Status}' gdm3 2>/dev/null)"
    if [[ "$status" != installed ]]; then
        result PASS 'gdm3 is not installed; GDM-specific login-screen controls are not applicable'
        return
    fi
    config="$(grep -RhsE '^[[:space:]]*banner-message-(enable|text)[[:space:]]*=' /etc/dconf/db/gdm.d /etc/dconf/profile/gdm 2>/dev/null)"
    banner_enabled="$(printf '%s\\n' "$config" | awk -F= '/banner-message-enable/ {gsub(/[[:space:]]/,"",$2); value=$2} END {print value}')"
    banner_text="$(printf '%s\\n' "$config" | awk -F= '/banner-message-text/ {found=1} END {print found+0}')"
    if [[ "$banner_enabled" == true && "$banner_text" == 1 ]]; then
        result PASS 'gdm3 is installed and a GDM banner enable setting plus banner text were found; verify effective dconf policy'
    else
        result WARN "gdm3 is installed but a complete GDM login banner was not confirmed (enabled=${banner_enabled:-not-set}, text-found=$banner_text)"
    fi
}

check_x_window_system() {
    local installed=0 packages='' p status
    if ! have dpkg-query; then
        result UNKNOWN 'dpkg-query unavailable; cannot inventory X server packages'
        return
    fi
    for p in xserver-xorg-core xserver-common xwayland; do
        status="$(dpkg-query -W -f='${db:Status-Status}' "$p" 2>/dev/null)"
        if [[ "$status" == installed ]]; then
            installed=$((installed + 1))
            packages+="${packages:+,}$p"
        fi
    done
    if (( installed == 0 )); then
        result PASS 'no checked X server/Xwayland packages are installed'
    else
        result INFO "$installed checked graphical server package(s) installed ($packages); confirm whether a graphical stack is required for this host role"
    fi
}

check_avahi_autofs_services() {
    local active=0 enabled=0 installed=0 unit state
    for unit in avahi-daemon.service avahi-daemon.socket autofs.service; do
        if is_active "$unit"; then active=$((active + 1)); fi
        if have systemctl; then
            state="$(systemctl is-enabled "$unit" 2>/dev/null || true)"
            [[ "$state" == enabled || "$state" == enabled-runtime ]] && enabled=$((enabled + 1))
        fi
    done
    if have dpkg-query; then
        for unit in avahi-daemon autofs; do
            state="$(dpkg-query -W -f='${db:Status-Status}' "$unit" 2>/dev/null)"
            [[ "$state" == installed ]] && installed=$((installed + 1))
        done
    fi
    if (( active > 0 || enabled > 0 )); then
        result WARN "Avahi/Autofs units active=$active enabled=$enabled; disable only if not required by the host role"
    elif (( installed > 0 )); then
        result INFO "$installed Avahi/Autofs package(s) installed but no checked unit is active or enabled"
    else
        result PASS 'no checked Avahi/Autofs package or active/enabled unit detected'
    fi
}

check_journald_configuration() {
    local config storage compress forward
    if ! have systemd-analyze; then
        result UNKNOWN 'systemd-analyze unavailable; cannot read effective journald configuration'
        return
    fi
    config="$(systemd-analyze cat-config systemd/journald.conf 2>/dev/null)" || {
        result UNKNOWN 'unable to read effective journald configuration'
        return
    }
    storage="$(awk -F= '/^[[:space:]]*Storage[[:space:]]*=/ {gsub(/[[:space:]]/,"",$2); v=tolower($2)} END {print v}' <<< "$config")"
    compress="$(awk -F= '/^[[:space:]]*Compress[[:space:]]*=/ {gsub(/[[:space:]]/,"",$2); v=tolower($2)} END {print v}' <<< "$config")"
    forward="$(awk -F= '/^[[:space:]]*ForwardToSyslog[[:space:]]*=/ {gsub(/[[:space:]]/,"",$2); v=tolower($2)} END {print v}' <<< "$config")"
    if [[ "$storage" == persistent && "$compress" == yes ]]; then
        result PASS "journald effective settings include Storage=persistent and Compress=yes (ForwardToSyslog=${forward:-default})"
    elif [[ -z "$storage" && -z "$compress" ]]; then
        result UNKNOWN 'Storage and Compress are not explicitly configured; systemd defaults may apply'
    else
        result WARN "journald settings require review (Storage=${storage:-default}, Compress=${compress:-default}, ForwardToSyslog=${forward:-default})"
    fi
}

check_logrotate_configuration() {
    local output
    if ! have logrotate; then
        result WARN 'logrotate command is not installed'
        return
    fi
    if [[ ! -r /etc/logrotate.conf ]]; then
        result UNKNOWN '/etc/logrotate.conf is missing or unreadable'
        return
    fi
    output="$(logrotate -d /etc/logrotate.conf 2>&1)"
    if [[ "$output" == *'error'* || "$output" == *'error:'* ]]; then
        result WARN 'logrotate debug validation reported an error; inspect logrotate -d /etc/logrotate.conf output locally'
    else
        result PASS 'logrotate is installed and its configuration passed debug-mode parsing (no rotation was performed)'
    fi
}

check_rsyslog_service() {
    local installed=0 active=0 enabled='unknown'
    if have dpkg-query; then
        [[ "$(dpkg-query -W -f='${db:Status-Status}' rsyslog 2>/dev/null)" == installed ]] && installed=1
    elif have rpm; then
        rpm -q rsyslog >/dev/null 2>&1 && installed=1
    else
        have rsyslogd && installed=1
    fi
    is_active rsyslog.service && active=1
    if have systemctl; then enabled="$(systemctl is-enabled rsyslog.service 2>/dev/null || true)"; fi
    if (( active )); then
        result PASS "rsyslog service is active (installed=$installed, enabled=$enabled)"
    elif (( installed )); then
        result WARN "rsyslog is installed but service is not active (enabled=$enabled)"
    else
        result WARN 'rsyslog package/service was not detected; verify whether journald alone satisfies the logging design'
    fi
}

check_process_accounting() {
    local installed=0 active=0 evidence=0 unit
    for unit in acct.service psacct.service; do is_active "$unit" && active=1; done
    if have dpkg-query; then
        [[ "$(dpkg-query -W -f='${db:Status-Status}' acct 2>/dev/null)" == installed ]] && installed=1
    elif have rpm; then
        rpm -q psacct >/dev/null 2>&1 && installed=1
    fi
    have lastcomm && evidence=1
    [[ -s /var/account/pacct || -s /var/log/account/pacct ]] && evidence=1
    if (( active && evidence )); then
        result PASS 'process accounting service and accounting evidence detected'
    elif (( installed )); then
        result WARN "process-accounting package is installed but active service/evidence was not confirmed (active=$active, evidence=$evidence)"
    else
        result WARN 'process accounting (acct/psacct) was not detected; enable only if required by the applicable benchmark/profile'
    fi
}

# ---------- Test registry and resilient runner ----------

# ---------- CIS Ubuntu 22.04 LTS Benchmark v3.0.0 additions ----------
# These checks are read-only and deliberately return UNKNOWN when the required
# local evidence is unavailable. They do not install packages or change settings.

cis_sysctl_check() {
    local key="$1" expected="$2" current
    if ! have sysctl; then result UNKNOWN 'sysctl command unavailable'; return; fi
    current="$(sysctl -n "$key" 2>/dev/null)" || { result UNKNOWN "cannot read $key"; return; }
    if [[ "$current" == "$expected" ]]; then result PASS "$key=$current";
    else result FAIL "$key=$current; expected $expected"; fi
}

cis_mount_option_check() {
    local path="$1" option="$2" opts
    if ! have findmnt; then result UNKNOWN 'findmnt command unavailable'; return; fi
    opts="$(findmnt -n -o OPTIONS --target "$path" 2>/dev/null)" || { result UNKNOWN "cannot determine mount for $path"; return; }
    case ",$opts," in *,"$option",*) result PASS "$path mount has $option";;
        *) result FAIL "$path mount options do not include $option (actual: ${opts:-unknown})";; esac
}

cis_separate_mount_check() {
    local path="$1" source root_source
    if ! have findmnt; then result UNKNOWN 'findmnt command unavailable'; return; fi
    source="$(findmnt -n -o SOURCE --target "$path" 2>/dev/null)" || { result UNKNOWN "cannot determine mount source for $path"; return; }
    root_source="$(findmnt -n -o SOURCE --target / 2>/dev/null)" || { result UNKNOWN 'cannot determine root mount source'; return; }
    if [[ "$source" != "$root_source" ]]; then result PASS "$path is on a mount source distinct from root ($source)";
    else result FAIL "$path shares the root mount source ($root_source)"; fi
}

cis_module_disabled_check() {
    local module="$1" conf loaded
    if ! have modprobe; then result UNKNOWN 'modprobe unavailable'; return; fi
    conf="$(modprobe -n -v "$module" 2>/dev/null | head -n 1)"
    loaded="$(awk -v m="$module" '$1==m {print $1}' /proc/modules 2>/dev/null)"
    if [[ "$conf" =~ install[[:space:]]+(/bin/false|/usr/bin/false|/bin/true|/usr/bin/true) ]] && [[ -z "$loaded" ]]; then
        result PASS "$module is blocked by modprobe configuration and not loaded"
    elif [[ -z "$conf" && -z "$loaded" ]]; then
        result INFO "$module is not currently loaded; absence of a block rule was not established"
    else
        result FAIL "$module may be loadable or is loaded (modprobe=${conf:-no-rule}, loaded=${loaded:-no})"
    fi
}

cis_service_not_in_use_check() {
    local unit="$1" pkg="$2" active='inactive' installed='unknown'
    if have systemctl && systemctl is-active --quiet "$unit" 2>/dev/null; then active='active'; fi
    if have dpkg-query; then
        if dpkg-query -W -f='${db:Status-Status}' "$pkg" 2>/dev/null | grep -qx installed; then installed='installed'; else installed='not-installed'; fi
    fi
    if [[ "$active" == active ]]; then result FAIL "$unit is active (package $pkg=$installed)";
    elif [[ "$installed" == not-installed ]]; then result PASS "$unit is not active and $pkg is not installed";
    elif [[ "$installed" == installed ]]; then result WARN "$pkg is installed but $unit is not active; verify it is disabled and not required";
    else result UNKNOWN "cannot verify both service $unit and package $pkg"; fi
}

cis_file_mode_check() {
    local path="$1" expected="$2" actual owner
    [[ -e "$path" ]] || { result UNKNOWN "$path does not exist"; return; }
    actual="$(stat -c '%a' "$path" 2>/dev/null)" || { result UNKNOWN "cannot stat $path"; return; }
    owner="$(stat -c '%U:%G' "$path" 2>/dev/null)" || owner='unknown'
    local actual_num expected_num
    actual_num=$((8#$actual)); expected_num=$((8#$expected))
    if (( actual_num <= expected_num )) && [[ "$owner" == root:root ]]; then result PASS "$path mode=$actual owner=$owner";
    else result FAIL "$path mode=$actual owner=$owner; expected mode no more permissive than $expected and owner=root:root"; fi
}

cis_sshd_expect_check() {
    local key="$1" expected="$2" actual
    actual="$(sshd_value "$key" 2>/dev/null)"
    if [[ -z "$actual" ]]; then result UNKNOWN "effective sshd setting $key unavailable";
    elif [[ "$actual" == "$expected" ]]; then result PASS "effective $key=$actual";
    else result FAIL "effective $key=$actual; expected $expected"; fi
}

